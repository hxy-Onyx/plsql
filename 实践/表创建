primary key (GRADE, CLASS_NO)
);
//削除
DROP TABLE class;
//新しいクラステーブルの作成、新しい列を加入した
create table class(
GRADE             VARCHAR2(1) not null,
CLASS_NO          NUMBER(2) not null,
CLASS_NAME        VARCHAR2(20),
FIRST_TEACHER     VARCHAR2(50),
CLASSROOM_NO      VARCHAR2(3),
